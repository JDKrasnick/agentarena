{
  "name": "agent-arena",
  "version": "0.1.0",
  "packageManager": "npm@11.8.0",
  "description": "Make your coding agents fight for the merge.",
  "type": "module",
  "bin": {
    "agent-arena": "./dist/cli.js"
  },
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json && npm run build:web",
    "build:web": "vite build",
    "dev": "tsx src/cli.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:unit": "vitest run test/unit",
    "test:integration": "vitest run test/integration",
    "test:process-timeout-repro": "vitest run test/reproduction/process-timeout-reproduction.test.ts --reporter=verbose",
    "test:smoke": "vitest run test/smoke",
    "test:coverage": "vitest run test/unit test/integration --coverage.enabled --coverage.reporter=text --coverage.reporter=json-summary",
    "test:live": "tsx test/live/run.ts",
    "demo:dashboard": "tsx test/live/dashboard-demo.tsx",
    "demo:web": "npm run build:web && tsx test/live/web-dashboard-demo.ts",
    "test:package": "npm run build && npm pack --dry-run",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "coding-agents",
    "testing",
    "cli",
    "codex",
    "claude"
  ],
  "license": "MIT",
  "dependencies": {
    "@lobehub/icons-static-png": "^1.95.0",
    "commander": "^14.0.0",
    "execa": "^9.6.0",
    "ink": "^6.8.0",
    "ink-link": "^5.0.0",
    "ink-picture": "^2.1.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "yaml": "^2.8.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.1.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitest/coverage-v8": "^4.1.10",
    "eslint": "^10.8.0",
    "ink-testing-library": "^4.0.0",
    "prettier": "^3.6.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.38.0",
    "vite": "^7.3.6",
    "vitest": "^4.1.10"
  }
}
